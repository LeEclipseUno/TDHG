# Optional online features (friend groups, daily percentile, share previews) on Supabase.
# Without these the game runs fully offline. Both values are safe to publish: the anon key is meant for browsers.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Daily reminders: the public VAPID key (the private one goes to supabase secrets, see supabase/functions/remind).
VITE_VAPID_PUBLIC=
# Wegenkenner Plus: the Lemon Squeezy checkout link and the price text on the button (for example "€ 4,99 per jaar").
VITE_PLUS_CHECKOUT=
VITE_PLUS_PRICE=
